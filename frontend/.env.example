# Copy to .env.local (git-ignored). Only PUBLIC values belong in the frontend.
VITE_API_URL=http://127.0.0.1:8000
# Supabase login (public by design: URL + publishable key). Never put the service role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Local development without login (vite dev only; the API must run with ENVIRONMENT=local AUTH_LOCAL_BYPASS=true)
VITE_AUTH_BYPASS=false
