# Copy to backend/.env (or the repository-root .env) and fill in. NEVER commit .env.
ENVIRONMENT=local

# Supabase project
SUPABASE_PROJECT_REF=vhdhqpaxandnuqykjweq
SUPABASE_URL=https://vhdhqpaxandnuqykjweq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Database — Supabase dashboard -> Connect -> "Session pooler"
DATABASE_HOST=aws-0-<region>.pooler.supabase.com
DATABASE_PORT=5432
DATABASE_NAME=postgres
DATABASE_USER=postgres.vhdhqpaxandnuqykjweq
DATABASE_PASSWORD=
DATABASE_SSLMODE=require

# LOCAL development database only (e.g. the Docker one). Leave empty to use the settings above.
# DATABASE_URL=postgresql://postgres:<password>@127.0.0.1:54329/bettory_dev

# Auth (single owner): Supabase dashboard -> Authentication -> Users -> your user id
OWNER_USER_ID=
# Only for projects on the legacy shared JWT secret; new projects need nothing here.
SUPABASE_JWT_SECRET=
# LOCAL ONLY: try the endpoints in /docs without logging in (from this machine only).
# Refused when ENVIRONMENT is not "local". Never set this on the server.
AUTH_LOCAL_BYPASS=false
CORS_ORIGINS=["http://localhost:5173"]

API_FOOTBALL_KEY=
# free | pro  (pro: goal minutes for 20 matches per request; set after upgrading the subscription)
API_FOOTBALL_PLAN=free
# Request cap per job run (free plan: 100 per day in total)
API_FOOTBALL_MAX_REQUESTS_PER_RUN=90
# Per-minute limit of the plan (free: 10). Requests are spaced 60 / this many seconds apart
API_FOOTBALL_REQUESTS_PER_MINUTE=10
FOOTBALL_DATA_ORG_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

PARAMS_FILE=config/params_v1.5.yaml
